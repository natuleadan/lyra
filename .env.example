# Environment Variables for Natuleadan Lyra (Local & CI Contract)
# Local dev: copy to .env (git-ignored) and populate required values.
# CI/CD: sync required vars via `gh variable set <KEY> --repo natuleadan/lyra`.

# [var] Audio runtime environment (development | staging | production)
LYRA_ENV=development
# [var] Default audio sample rate in Hz
LYRA_SAMPLE_RATE=48000
# [var] Logging verbosity (error | warn | info | debug)
LYRA_LOG_LEVEL=info
